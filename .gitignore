# Local hardware and software inventory dumps (generated per machine)
inventory/hardware.json
inventory/hardware.md
inventory/software.json
inventory/software.md
inventory/pkg-lists/*
!inventory/pkg-lists/.gitkeep

# Active local session memory (keep templates in git)
memory/*.md
!memory/*.md.template

# User workstation overrides and local profiles
*.local.*
AGENTS.local.md
.env
.env.*
!.env.example

# Machine-specific backups and snapshots
.backup/
*.bak
*.bak_*
scripts/local_*

# Dynamically generated user/local agent skills (tailored per machine, private)
.agents/skills/local-*
.agents/skills/user-*
.agents/skills/custom-*
.agents/skills/local/

# General IDE and OS artifacts
.DS_Store
*.swp
*~
.vscode/
.idea/
.obsidian/
.trash/

# Local production workspaces and scratch media (excluded from git)
work/*
!work/.gitkeep
work/runs/
work/latest
/workspaces/

# Python artifacts and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/.venv/
/.venv-*/
.venv/
.venv-*/
/models/
/model/
/.cache/

# Private voice reference samples (strictly excluded from git)
voice/*
!voice/README.md
!voice/sample_reference.wav
!voice/.gitkeep
voice/custom/

# Local hardware and software inventory dumps (generated per machine)
inventory/hardware.json
inventory/hardware.md
inventory/software.json
inventory/software.md
inventory/pkg-lists/*
!inventory/pkg-lists/.gitkeep

# Active local session memory (keep templates in git)
memory/SESSION_STATE.md
memory/JOURNAL.md

# User workstation overrides (keep template AGENTS.local.md.template in git)
AGENTS.local.md

# Machine-specific backups and snapshots
.backup/
*.bak
*.bak_*
scripts/local_*

# Dynamically generated user/local agent skills (tailored per machine, private)
.agents/skills/local-*
.agents/skills/user-*
.agents/skills/custom-*
.agents/skills/local/

# General IDE and OS artifacts
.DS_Store
*.swp
*~
.vscode/
.idea/
.obsidian/

# ==============================================================================
# WORKSTATION HUB: Environment Variables Template
# Skopiuj ten plik jako '.env' i dostosuj do swojego środowiska:
#   cp .env.example .env
# ==============================================================================

# Ścieżka do próbki głosu lektora (opcjonalne, gdy w work/voice_sample/ znajduje się więcej niż 1 plik)
VOICE_REF_FILE=work/voice_sample/ref_voice_sample.wav

# Domyślny katalog modeli AI (np. Breeze-TTS-2, MarianMT)
MODELS_DIR=models/Breeze-TTS-2

# Opcjonalne ręczne nadpisanie nazw ekranów (domyślnie pobierane z inventory/hardware.json)
PRIMARY_DISPLAY=
SECONDARY_DISPLAY=

# Opcjonalne klucze API / integracje zewnętrzne (np. Hugging Face Token dla zastrzeżonych modeli)
# HF_TOKEN=hf_...
